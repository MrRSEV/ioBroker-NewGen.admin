<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <HostRuntimePath Condition="'$(HostRuntimePath)' == ''">lib\ioBroker-NewGen.dll</HostRuntimePath>
    <RsevUtilitiesPath Condition="'$(RsevUtilitiesPath)' == ''">lib\RSEV.Utilities.dll</RsevUtilitiesPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="lib\ioBroker-NewGen.dll;lib\RSEV.Utilities.dll" />
    <Reference Include="ioBroker-NewGen">
      <HintPath>$(HostRuntimePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RSEV.Utilities">
      <HintPath>$(RsevUtilitiesPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
